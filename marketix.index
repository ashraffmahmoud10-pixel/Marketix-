<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#06060f">
<meta name="description" content="Marketix — وكالة تسويق رقمي وصناعة محتوى متكاملة">
<title>Marketix — وكالة التسويق الرقمي</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:#06060f;color:#f0f0ff;font-family:'Cairo',Arial,sans-serif;overflow-x:hidden;line-height:1.6}
a{text-decoration:none;color:inherit}
::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{background:linear-gradient(#ff2d6e,#7c3aed);border-radius:3px}
:root{--pink:#ff2d6e;--violet:#7c3aed;--cyan:#06d6f5;--gold:#f5c518;--muted:#8888aa;--surface:#0f0f1e;--border:rgba(255,255,255,.08)}

/* ── NAV ── */
nav{position:sticky;top:0;z-index:99;display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.3rem;background:rgba(6,6,15,.93);border-bottom:1px solid var(--border)}
.logo{font-size:1.4rem;font-weight:900;letter-spacing:3px;background:linear-gradient(135deg,#ff2d6e,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.logo-sub{font-size:.5rem;color:var(--muted);letter-spacing:2px;text-align:center;display:block}
.wa-nav{display:flex;align-items:center;gap:.4rem;background:#25d366;color:#fff;padding:.55rem 1.1rem;border-radius:50px;font-size:.82rem;font-weight:700;font-family:inherit}

/* ── HERO ── */
.hero{min-height:88vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:3rem 1.4rem 0;background:radial-gradient(ellipse 90% 60% at 80% 5%,rgba(124,58,237,.2) 0%,transparent 55%),radial-gradient(ellipse 80% 55% at 15% 95%,rgba(255,45,110,.15) 0%,transparent 55%),#06060f}
.badge{display:inline-flex;align-items:center;gap:.45rem;border:1px solid rgba(255,45,110,.3);padding:.38rem 1rem;border-radius:50px;font-size:.72rem;color:var(--pink);background:rgba(255,45,110,.07);margin-bottom:1.5rem}
.dot{width:6px;height:6px;background:var(--pink);border-radius:50%;animation:blink 1.8s infinite;flex-shrink:0}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
h1{font-size:clamp(2.3rem,10vw,5rem);font-weight:900;line-height:1.05;margin-bottom:1rem}
.g1{background:linear-gradient(135deg,#ff2d6e,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.g2{background:linear-gradient(135deg,#06d6f5,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.g3{background:linear-gradient(135deg,#f5c518,#ff2d6e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-p{color:var(--muted);font-size:.92rem;line-height:1.9;max-width:420px;margin:0 auto 1.8rem}
.hero-p b{color:#f0f0ff}
.btns{display:flex;flex-direction:column;gap:.75rem;width:100%;max-width:300px}
.btn-main{display:flex;align-items:center;justify-content:center;gap:.5rem;background:linear-gradient(135deg,#ff2d6e,#7c3aed);color:#fff;padding:.9rem 1.5rem;border-radius:50px;font-size:.95rem;font-weight:700;font-family:inherit;box-shadow:0 0 26px rgba(255,45,110,.35)}
.btn-out{display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.15);color:#f0f0ff;padding:.85rem 1.5rem;border-radius:50px;font-size:.9rem;font-weight:600;background:rgba(255,255,255,.04)}

/* STATS */
.stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);margin-top:2.5rem;width:100%;border-top:1px solid var(--border)}
.stat{background:#06060f;padding:1.4rem .5rem;text-align:center}
.sn{font-size:2rem;font-weight:900;display:block;background:linear-gradient(135deg,#ff2d6e,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:.3rem}
.sl{font-size:.72rem;color:var(--muted);line-height:1.4}

/* ── MARQUEE ── */
.mq{overflow:hidden;padding:.9rem 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(255,255,255,.015)}
.mq-t{display:flex;gap:2rem;white-space:nowrap;animation:mq 22s linear infinite;width:max-content}
.mi{font-size:.64rem;color:var(--muted);letter-spacing:2.5px;text-transform:uppercase;font-weight:700}
.md{color:var(--pink);margin:0 .2rem}
@keyframes mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── SECTION BASE ── */
.sec{padding:2.8rem 1.4rem}
.bg-s{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.tag{font-size:.62rem;letter-spacing:3.5px;color:var(--pink);text-transform:uppercase;font-weight:700;display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem}
.tag::before{content:'';width:22px;height:2px;background:var(--pink);flex-shrink:0}
h2{font-size:clamp(1.5rem,6vw,2.3rem);font-weight:900;line-height:1.15;margin-bottom:.6rem}
.sp{color:var(--muted);font-size:.88rem;line-height:1.85;margin-bottom:2rem}

/* ── VISION ── */
.vision{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:2.5rem 1.4rem;text-align:center}
.vision h2{font-size:clamp(1.3rem,5.5vw,2rem);margin-bottom:.8rem}
.vision p{color:var(--muted);font-size:.88rem;line-height:1.85;max-width:460px;margin:0 auto}

/* ── SERVICES ── */
.svc-list{display:flex;flex-direction:column;gap:1rem;margin-top:1rem}
.svc{background:#09091a;border:1px solid var(--border);border-radius:16px;padding:1.6rem 1.4rem;position:relative;overflow:hidden}
.svc-head{display:flex;align-items:center;gap:.8rem;margin-bottom:.9rem}
.svc-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;border:1px solid}
.ic1{background:rgba(255,45,110,.1);border-color:rgba(255,45,110,.25)}
.ic2{background:rgba(124,58,237,.1);border-color:rgba(124,58,237,.25)}
.ic3{background:rgba(6,214,245,.1);border-color:rgba(6,214,245,.25)}
.ic4{background:rgba(245,197,24,.1);border-color:rgba(245,197,24,.25)}
.ic5{background:rgba(255,45,110,.08);border-color:rgba(255,100,150,.2)}
.svc-title-wrap{}
.svc-en{font-size:.62rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted);font-weight:700}
.svc h3{font-size:1rem;font-weight:900;color:#f0f0ff;line-height:1.2}
.svc-desc{color:var(--muted);font-size:.86rem;line-height:1.85;margin-bottom:1rem}
.svc-points{list-style:none;display:flex;flex-direction:column;gap:.45rem}
.svc-points li{font-size:.82rem;color:#aaaacc;display:flex;align-items:flex-start;gap:.5rem;line-height:1.55}
.svc-points li::before{content:'✦';color:var(--pink);font-size:.6rem;flex-shrink:0;margin-top:.2rem}
.svc-accent{position:absolute;bottom:0;right:0;height:2px;width:40%}
.a1{background:linear-gradient(90deg,#ff2d6e,#7c3aed)}
.a2{background:linear-gradient(90deg,#06d6f5,#7c3aed)}
.a3{background:linear-gradient(90deg,#f5c518,#ff2d6e)}
.a4{background:linear-gradient(90deg,#06d6f5,#ff2d6e)}
.a5{background:linear-gradient(90deg,#ff2d6e,#06d6f5)}

/* ── PACKAGES ── */
.pkg-list{display:flex;flex-direction:column;gap:1rem;margin-top:1rem}
.pkg{background:#09091a;border:1px solid var(--border);border-radius:18px;padding:1.8rem 1.4rem;position:relative;overflow:hidden}
.pkg.featured{border-color:rgba(255,45,110,.45);background:linear-gradient(145deg,rgba(124,58,237,.1),rgba(255,45,110,.06))}
.pkg-badge{position:absolute;top:1rem;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#ff2d6e,#7c3aed);color:#fff;font-size:.65rem;font-weight:700;padding:.28rem 1rem;border-radius:50px;white-space:nowrap}
.pkg-tier{font-size:.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.3rem;margin-top:1.8rem}
.pkg-name{font-size:1.2rem;font-weight:900;margin-bottom:.2rem}
.pkg-price{font-size:2.2rem;font-weight:900;color:var(--pink);line-height:1;margin-bottom:.15rem}
.pkg-price small{font-size:.85rem;color:var(--muted);font-weight:400}
.pkg-mo{font-size:.78rem;color:var(--muted);margin-bottom:.8rem}
.pkg-desc{color:var(--muted);font-size:.84rem;line-height:1.75;margin-bottom:1.1rem;padding-bottom:1rem;border-bottom:1px solid var(--border)}
.pkg-features{list-style:none;display:flex;flex-direction:column;gap:.55rem}
.pkg-features li{font-size:.84rem;color:#aaaacc;display:flex;align-items:flex-start;gap:.55rem;line-height:1.5}
.pkg-features li::before{content:'✓';color:var(--pink);font-weight:900;flex-shrink:0}
.pkg-cta{display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:1.4rem;padding:.9rem;border-radius:50px;font-size:.9rem;font-weight:700;font-family:inherit}
.cta-fill{background:linear-gradient(135deg,#ff2d6e,#7c3aed);color:#fff;border:none;box-shadow:0 0 22px rgba(255,45,110,.3)}
.cta-out{background:transparent;color:#f0f0ff;border:1px solid rgba(255,255,255,.15)}

/* ── PARTNERS ── */
.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-top:1.5rem}
.pc{background:#09091a;border:1px solid var(--border);border-radius:14px;padding:1.2rem 1rem}
.pc-wide{grid-column:span 2;background:rgba(255,45,110,.04);border-color:rgba(255,45,110,.14)}
.pc-ic{font-size:1.4rem;margin-bottom:.4rem}
.pc-s{font-size:.58rem;letter-spacing:2px;text-transform:uppercase;color:var(--pink);font-weight:700;margin-bottom:.2rem}
.pc-n{font-size:.82rem;font-weight:800;line-height:1.3}

/* ── RESULTS ── */
.rgrid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-top:1.5rem}
.rc{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:1.4rem 1rem}
.rn{font-size:2rem;font-weight:900;line-height:1;margin-bottom:.3rem}
.rc:nth-child(1) .rn{background:linear-gradient(135deg,#ff2d6e,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.rc:nth-child(2) .rn{background:linear-gradient(135deg,#06d6f5,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.rc:nth-child(3) .rn{background:linear-gradient(135deg,#f5c518,#ff2d6e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.rc:nth-child(4) .rn{color:var(--cyan)}
.rl{color:var(--muted);font-size:.75rem;line-height:1.5}

/* ── PROCESS ── */
.plist{display:flex;flex-direction:column;gap:.85rem;margin-top:1.5rem}
.pi{display:flex;gap:1rem;align-items:flex-start;padding:1.3rem;background:var(--surface);border:1px solid var(--border);border-radius:14px}
.pnum{font-size:2rem;font-weight:900;line-height:1;flex-shrink:0;width:42px;background:linear-gradient(135deg,#ff2d6e,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.pi h3{font-size:.9rem;font-weight:800;margin-bottom:.3rem}
.pi p{color:var(--muted);font-size:.8rem;line-height:1.7}

/* ── CTA ── */
.cta{background:linear-gradient(135deg,#ff2d6e,#7c3aed);padding:3rem 1.4rem;text-align:center;position:relative;overflow:hidden}
.cta::before{content:'MX';position:absolute;font-size:55vw;font-weight:900;color:rgba(0,0,0,.1);top:50%;left:50%;transform:translate(-50%,-50%);letter-spacing:10px;pointer-events:none;line-height:1}
.cta h2{font-size:clamp(1.5rem,7vw,2.8rem);font-weight:900;margin-bottom:.75rem;position:relative}
.cta p{font-size:.9rem;opacity:.9;margin-bottom:2rem;position:relative;line-height:1.8}
.wa-big{display:inline-flex;align-items:center;gap:.6rem;background:#fff;color:#128c7e;padding:.9rem 2rem;border-radius:50px;font-size:.95rem;font-weight:800;font-family:inherit;position:relative}

/* ── CONTACT ── */
.cinfo{display:flex;flex-direction:column;gap:.75rem;margin-bottom:1.8rem}
.ci{display:flex;align-items:center;gap:.9rem;background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:.95rem 1.1rem}
.ci-ic{font-size:1.2rem;flex-shrink:0}
.ci-l{font-size:.65rem;color:var(--muted)}
.ci-v{font-weight:700;font-size:.88rem}
.form{display:flex;flex-direction:column;gap:.85rem}
.fg{display:flex;flex-direction:column;gap:.35rem}
.fg label{font-size:.75rem;color:var(--muted);font-weight:600}
.fg input,.fg select,.fg textarea{background:var(--surface);border:1px solid var(--border);color:#f0f0ff;padding:.85rem 1rem;border-radius:11px;font-family:inherit;font-size:.88rem;outline:none;width:100%;-webkit-appearance:none}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:rgba(255,45,110,.5);box-shadow:0 0 0 3px rgba(255,45,110,.1)}
.fg textarea{min-height:110px;resize:vertical}
.fg select option{background:#06060f}
.sbtn{background:linear-gradient(135deg,#ff2d6e,#7c3aed);color:#fff;border:none;padding:.95rem;border-radius:50px;width:100%;font-family:inherit;font-size:.95rem;font-weight:700;cursor:pointer;box-shadow:0 0 22px rgba(255,45,110,.3)}
.wa-form{display:flex;align-items:center;justify-content:center;gap:.5rem;background:#25d366;color:#fff;padding:.88rem;border-radius:50px;font-size:.9rem;font-weight:700;font-family:inherit;margin-top:.3rem}

/* ── FOOTER ── */
footer{background:var(--surface);border-top:1px solid var(--border);padding:2.5rem 1.4rem 1.5rem;text-align:center}
.f-logo{font-size:1.9rem;font-weight:900;letter-spacing:4px;background:linear-gradient(135deg,#ff2d6e,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:.4rem}
.f-d{color:var(--muted);font-size:.8rem;line-height:1.75;margin-bottom:1.5rem}
.f-soc{display:flex;gap:.65rem;justify-content:center;margin-bottom:2rem}
.soc{width:40px;height:40px;border-radius:50%;border:1px solid var(--border);background:#06060f;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.f-links{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2rem;text-align:right}
.flg h4{font-size:.62rem;letter-spacing:2.5px;text-transform:uppercase;color:var(--muted);margin-bottom:.7rem;font-weight:700}
.flg ul{list-style:none;display:flex;flex-direction:column;gap:.45rem}
.flg a{color:var(--muted);font-size:.8rem}
.f-c{color:var(--muted);font-size:.7rem;border-top:1px solid var(--border);padding-top:1.5rem;line-height:1.7}

/* ── REVEAL ── */
.rv{opacity:0;transform:translateY(20px);transition:opacity .55s ease,transform .55s ease}
.rv.in{opacity:1;transform:translateY(0)}

/* ── WA SVG ── */
.ws{width:17px;height:17px;fill:currentColor;flex-shrink:0}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div>
    <div class="logo">MARKETIX</div>
    <span class="logo-sub">وكالة التسويق الرقمي</span>
  </div>
  <a class="wa-nav" href="https://wa.me/201097112957" target="_blank">
    <svg class="ws" fill="#fff" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    واتساب
  </a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="badge"><span class="dot"></span>وكالة تسويق رقمي وصناعة محتوى</div>
  <h1><span class="g1">Marketix</span><br>البداية لقصص<br><span class="g2">نجاح حقيقية</span></h1>
  <p class="hero-p">هل تعلم أن <b>+90%</b> من الشركات الناجحة تعتمد على التسويق الإلكتروني كعامل أساسي في نموها؟<br>إحنا فريق متخصص بنحوّل مشروعك من مجرد اسم في السوق إلى براند مؤثر ومحبوب.</p>
  <div class="btns">
    <a class="btn-main" href="https://wa.me/201097112957" target="_blank">
      <svg class="ws" fill="#fff" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      📲 تواصل معنا على واتساب
    </a>
    <a class="btn-out" href="#services">اكتشف خدماتنا ↓</a>
  </div>
  <div class="stats">
    <div class="stat"><span class="sn">11+</span><span class="sl">شريك نجاح موثوق</span></div>
    <div class="stat"><span class="sn">90%+</span><span class="sl">نسبة رضا عملاؤنا</span></div>
    <div class="stat"><span class="sn">5</span><span class="sl">خدمات متكاملة</span></div>
    <div class="stat"><span class="sn">100%</span><span class="sl">التزام بالنتائج</span></div>
  </div>
</section>

<!-- MARQUEE -->
<div class="mq">
  <div class="mq-t">
    <span class="mi">سوشيال ميديا<span class="md">◆</span></span><span class="mi">صناعة محتوى<span class="md">◆</span></span><span class="mi">فيديو تسويقي<span class="md">◆</span></span><span class="mi">استراتيجية<span class="md">◆</span></span><span class="mi">تحليلات أداء<span class="md">◆</span></span><span class="mi">Social Media<span class="md">◆</span></span><span class="mi">Content Creation<span class="md">◆</span></span><span class="mi">Video Marketing<span class="md">◆</span></span><span class="mi">Digital Strategy<span class="md">◆</span></span>
